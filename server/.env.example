PORT=5000
MONGO_URI=mongodb://localhost:27017/vetrelief
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGINS=http://localhost:5173
TRUST_PROXY=true
CRON_SECRET=replace-with-a-random-secret-at-least-16-characters-long
# Optional password-reset email delivery through Resend.
RESEND_API_KEY=
RESET_EMAIL_FROM=VetRelief <accounts@example.com>
# Optional. Keep the API key on the backend only; no AI features call OpenAI until this is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
